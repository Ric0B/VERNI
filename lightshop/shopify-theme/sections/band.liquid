<section class="band">
  <div class="wrap">
    <div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
    {%- if section.settings.link_label != blank -%}<a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Für Restaurants, Cafés und Hotels" },
    { "type": "text", "id": "text", "label": "Text", "default": "Serien ab 10 Lampen, Farben nach Ihrem Konzept, Lieferung in 3 bis 4 Wochen." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Ansehen →" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Band" } ]
}
{% endschema %}
