<section class="section{% if section.settings.night %} night{% endif %}">
  <div class="wrap">
    <div class="section-head">
      <div class="prose">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}<a href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} →</a>{%- endif -%}
    </div>
    <div class="grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="card"><div class="card-art">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kollektion" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "checkbox", "id": "night", "label": "Dark background", "default": false }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
