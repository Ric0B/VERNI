<footer class="site-foot">
  <div class="wrap">
    <div class="foot-news">
      <p class="logo">{{ section.settings.brand_a }}<span>{{ section.settings.brand_b }}</span></p>
      <p>{{ section.settings.tagline }}</p>
      <h2>{{ 'newsletter.heading' | t }}</h2>
      {%- form 'customer', class: 'inline-form', id: 'FooterNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="skip" for="FooterEmail">{{ 'newsletter.email' | t }}</label>
        <input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
        <button class="btn" type="submit">{{ 'newsletter.button' | t }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading }}</h2>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
    <div class="fineprint">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ section.settings.made }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "brand_a", "label": "Brand name, first part", "default": "Schicht" },
    { "type": "text", "id": "brand_b", "label": "Brand name, accent part", "default": "licht" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Lampen aus Schichten. Entworfen, gedruckt und von Hand montiert in der Schweiz." },
    { "type": "text", "id": "made", "label": "Bottom line", "default": "Gedruckt und montiert in der Schweiz" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": { "blocks": [ { "type": "menu" } ] }
}
{% endschema %}
