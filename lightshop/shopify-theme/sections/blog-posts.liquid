<section class="section">
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.blog != blank -%}<a href="{{ section.settings.blog.url }}">{{ 'general.view_all' | t }} →</a>{%- endif -%}</div>
    <div class="posts">
      {%- if section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: 3 -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
