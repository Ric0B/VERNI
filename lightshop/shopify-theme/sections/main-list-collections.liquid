<section class="section">
  <div class="wrap">
    <div class="section-head"><h1>{{ 'collection.all' | t }}</h1></div>
    <div class="grid">
      {%- for collection in collections -%}
        <a class="card" href="{{ collection.url }}">
          <div class="card-art">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 40rem) 100vw, 33vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="card-meta"><h3>{{ collection.title }}</h3><span class="price">{{ collection.products_count }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
