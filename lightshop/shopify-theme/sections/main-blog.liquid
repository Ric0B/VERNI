<section class="section">
  <div class="wrap">
    <div class="section-head"><h1>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 12 -%}
      <div class="posts">
        {%- for article in blog.articles -%}{% render 'article-card', article: article %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
