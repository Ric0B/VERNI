<section class="section">
  <div class="wrap split">
    <div class="prose"><h2>{{ section.settings.heading }}</h2>{{ section.settings.text }}</div>
    <div>
      {%- form 'contact', class: 'form', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}<p class="form-msg" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-msg" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="ContactName">{{ 'contact.name' | t }}<input id="ContactName" name="contact[name]" autocomplete="name"></label>
        <label for="ContactBusiness">{{ 'contact.business' | t }}<input id="ContactBusiness" name="contact[business]" autocomplete="organization"></label>
        <label for="ContactEmail">{{ 'contact.email' | t }}<input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email"></label>
        <label for="ContactQty">{{ 'contact.quantity' | t }}<select id="ContactQty" name="contact[quantity]"><option>1</option><option>10–24</option><option>25–49</option><option>50+</option></select></label>
        <label for="ContactBody">{{ 'contact.message' | t }}<textarea id="ContactBody" name="contact[body]" rows="5"></textarea></label>
        <button class="btn" type="submit">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Projekt anfragen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Serien ab 10 Lampen, Farben nach Konzept, Musterlampe zum halben Preis.</p>" }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
