<section class="hero night">
  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="lead">{{ section.settings.text }}</div>
      {%- form 'customer', class: 'inline-form', id: 'WaitlistForm' -%}
        <input type="hidden" name="contact[tags]" value="waitlist">
        <label class="skip" for="WaitlistEmail">{{ 'newsletter.email' | t }}</label>
        <input id="WaitlistEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
        <button class="btn light" type="submit">{{ 'newsletter.waitlist' | t }}</button>
        {%- if form.posted_successfully? -%}<p class="form-msg" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}
    </div>
    <div class="hero-art">
      {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image.alt }}{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waitlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bald: Lampen aus Schichten." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erste Serie: 50 nummerierte Lampen. Die Warteliste bekommt 48 Stunden Vorsprung.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ]
}
{% endschema %}
