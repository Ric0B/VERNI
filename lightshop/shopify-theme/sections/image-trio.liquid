<section class="section night">
  <div class="wrap">
    <div class="section-head">
      <div class="prose">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="btn light" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="seeds">
      {%- for block in section.blocks -%}
        <figure class="seed" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(max-width: 40rem) 100vw, 33vw', alt: block.settings.caption }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <figcaption>{{ block.settings.caption }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image trio (one-offs)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Unikate" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jeder Code ein anderes Muster" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Ansehen →" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "Code 0042" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Image trio", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" } ] } ]
}
{% endschema %}
