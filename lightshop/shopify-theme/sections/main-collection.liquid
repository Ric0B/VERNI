<section class="section">
  <div class="wrap">
    <div class="section-head"><div class="prose"><h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="lead">{{ collection.description }}</div>{%- endif -%}</div></div>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p>{{ 'collection.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
<script type="application/ld+json">
  {"@context":"https://schema.org","@type":"ItemList","itemListElement":[{%- for product in collection.products limit: 24 -%}{"@type":"ListItem","position":{{ forloop.index }},"url":{{ request.origin | append: product.url | json }},"name":{{ product.title | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>

{% schema %}
{
  "name": "Collection",
  "settings": [ { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 24, "step": 3, "default": 12 } ]
}
{% endschema %}
