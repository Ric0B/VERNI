<section class="section"><div class="wrap prose">
  <h1>{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label for="ResetPassword">{{ 'customer.password' | t }}<input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password"></label>
    <label for="ResetConfirm">{{ 'customer.password_confirm' | t }}<input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password"></label>
    <button class="btn" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div></section>
