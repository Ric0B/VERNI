<section class="section"><div class="wrap prose">
  <h1>{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label for="RegFirst">{{ 'contact.name' | t }}<input id="RegFirst" name="customer[first_name]" autocomplete="given-name"></label>
    <label for="RegEmail">{{ 'contact.email' | t }}<input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></label>
    <label for="RegPassword">{{ 'customer.password' | t }}<input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button class="btn" type="submit">{{ 'customer.register' | t }}</button>
  {%- endform -%}
</div></section>
